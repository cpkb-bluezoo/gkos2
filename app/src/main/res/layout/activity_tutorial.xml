<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/tutorial_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0" />

        <!-- Step counter -->
        <TextView
            android:id="@+id/tutorial_step_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Instruction panel -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tutorial_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.3" />

        </ScrollView>

        <!-- Text output area -->
        <TextView
            android:id="@+id/tutorial_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            android:elevation="2dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Keyboard view -->
        <org.bluezoo.gkos.GkosKeyboardView
            android:id="@+id/tutorial_keyboard"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

    </LinearLayout>

    <!-- Skip button (floating top-right) -->
    <TextView
        android:id="@+id/tutorial_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/tutorial_skip"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

</FrameLayout>
